table Fact_Tickets_Unified
	lineageTag: 064ea4db-9fa5-4d6f-b4bf-d6710121cb03


	measure Tickets = COUNTROWS ( Fact_Tickets_Unified )
		formatString: #,0

	measure 'Tickets Helpdesk' =
			CALCULATE (
			    COUNTROWS ( Fact_Tickets_Unified ),
			    Fact_Tickets_Unified[HelpdeskTouched] = 1
			)
		formatString: #,0

	measure 'Tickets N2' =
			CALCULATE (
			    COUNTROWS ( Fact_Tickets_Unified ),
			    Fact_Tickets_Unified[EscalatedToN2] = 1
			)
		formatString: #,0

	measure 'Tickets N3' =
			CALCULATE (
			    COUNTROWS ( Fact_Tickets_Unified ),
			    Fact_Tickets_Unified[EscalatedToN3] = 1
			)
		formatString: #,0

	measure 'Escalade Helpdesk vers N2 %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Fact_Tickets_Unified ), Fact_Tickets_Unified[EscalatedToN2] = 1 ),
			    CALCULATE ( COUNTROWS ( Fact_Tickets_Unified ), Fact_Tickets_Unified[HelpdeskTouched] = 1 )
			)
		formatString: 0.0%

	measure 'Escalade N2 vers N3 %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Fact_Tickets_Unified ), Fact_Tickets_Unified[EscalatedToN3] = 1 ),
			    CALCULATE ( COUNTROWS ( Fact_Tickets_Unified ), Fact_Tickets_Unified[EscalatedToN2] = 1 )
			)
		formatString: 0.0%

	measure 'SLA Resolution %' = AVERAGE ( Fact_Tickets_Unified[SLA_Resolution_OK] )
		formatString: 0.0%

	measure 'SLA Premiere Reponse %' = AVERAGE ( Fact_Tickets_Unified[SLA_FirstResponse_OK] )
		formatString: 0.0%

	measure 'SLA Resolution Helpdesk %' =
			CALCULATE ( [SLA Resolution %], Fact_Tickets_Unified[ResolvedLevel] = "Helpdesk" )
		formatString: 0.0%

	measure 'SLA Resolution N2 %' =
			CALCULATE ( [SLA Resolution %], Fact_Tickets_Unified[ResolvedLevel] = "N2" )
		formatString: 0.0%

	measure 'SLA Resolution N3 %' =
			CALCULATE ( [SLA Resolution %], Fact_Tickets_Unified[ResolvedLevel] = "N3" )
		formatString: 0.0%

	measure 'Taux Reouverture %' = AVERAGE ( Fact_Tickets_Unified[Reopened] )
		formatString: 0.0%

	measure 'CSAT Moyen' = AVERAGE ( Fact_Tickets_Unified[CSAT] )
		formatString: 0.00

	measure 'Cible Escalade Helpdesk N2' = 0.30
		formatString: 0.0%

	measure 'Cible Escalade N2 N3' = 0.20
		formatString: 0.0%

	measure 'Taux Escalade Global %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Fact_Tickets_Unified ), Fact_Tickets_Unified[EscalatedToN2] = 1 ),
			    [Tickets]
			)
		formatString: 0.0%

	column TicketID
		dataType: string
