	partition Fact_Tickets_Unified = m
		mode: import
		source =
			```
let
    Source = Csv.Document(File.Contents(DataFolder & "Fact_Tickets_Unified.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
    Types = Table.TransformColumnTypes(Promoted, {
        {"TicketID", type text}, {"SourceSystem", type text}, {"CreatedDate", type datetime}, {"ClosedDate", type datetime},
        {"Priority", type text}, {"Application", type text}, {"Category", type text}, {"Status", type text},
        {"AssignmentLevel", type text}, {"HelpdeskTouched", Int64.Type}, {"EscalatedToN2", Int64.Type}, {"EscalatedToN3", Int64.Type},
        {"ResolvedLevel", type text}, {"FirstResponseHours", type number}, {"ResolutionHours", type number},
        {"SLA_FirstResponse_OK", Int64.Type}, {"SLA_Resolution_OK", Int64.Type}, {"Reopened", Int64.Type},
        {"CSAT", type number}, {"BusinessUnit", type text}, {"Month", type text}
    }),
    AddDate = Table.AddColumn(Types, "CreatedDateOnly", each Date.From([CreatedDate]), type date)
in
    AddDate
			```
